# ══════════════════════════════════════════════════════════════════════════════
# نظام متابعة الاقتصاد الأخضر – إعدادات البيئة
# انسخ هذا الملف إلى .env وعدّل القيم المناسبة
# ══════════════════════════════════════════════════════════════════════════════

# ── الأمان ────────────────────────────────────────────────────────────────────
# مفتاح سري قوي وعشوائي – لا تشاركه أبداً
SECRET_KEY=change-this-to-a-long-random-secret-key

# السر المستخدم لإنشاء أول مدير عبر /api/init-admin
SETUP_SECRET=init-green-2024

# ── قاعدة البيانات ────────────────────────────────────────────────────────────
# SQLite (افتراضي، لا حاجة لتعديل)
# DATABASE_URL=

# PostgreSQL (أزل التعليق واستبدل بمعلوماتك)
# DATABASE_URL=postgresql://user:password@localhost:5432/green_economy

# MySQL / MariaDB (XAMPP)
# DATABASE_URL=mysql://root:@localhost:3306/green_economy

# ── التنبيهات ─────────────────────────────────────────────────────────────────
# حد انبعاثات الكربون بالطن (تُرسَل تنبيهات عند تجاوزه)
CARBON_ALERT_THRESHOLD=1000

# ── البريد الإلكتروني (اختياري) ──────────────────────────────────────────────
MAIL_ENABLED=false
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_TO=admin@example.com

# ── الخادم ────────────────────────────────────────────────────────────────────
# PORT=5000
# FLASK_DEBUG=false
